    }
  ],
  "settings": [
    {
      "file": "/etc/avahi/avahi-daemon.conf",
      "kind": "avahi-daemon",
      "comment": "Discovery on every interface but the container bridge (pinning one Wi-Fi name silently stops discovery on a unit whose module enumerates differently); IPv4 addresses only, so clients don't latch onto a rotating privacy address and avahi doesn't re-register into a name conflict (atlas-xxxx-2.local); no host details published.",
      "values": {
        "server": {
          "use-ipv6": "no",
          "allow-interfaces": null,
          "deny-interfaces": "docker0"
        },
        "publish": {
          "publish-aaaa-on-ipv4": "no",
          "publish-hinfo": "no",
          "publish-workstation": "no"
        }
      }
    }
  ],
  "symlinks": [
    {
      "link": "/etc/nginx/sites-enabled/atlas",
      "target": "/etc/nginx/sites-available/atlas"
    }
  ],
  "enable": [
    "atlas-clock.service",
    "atlas-helper.socket",
    "atlas-update-recover.service",
    "atlas-firstboot.service",
    "atlas-firewall.service",
    "atlas-control.service",
    "zram-swap.service"
  ],
  "remove": [
    "/etc/avahi/services/atlas-http.service",
    "/etc/nginx/sites-enabled/default",
    "/etc/sysctl.d/99-zram.conf",
    "/usr/local/sbin/atlas-zram"
  ],
  "power_mode": "MAXN_SUPER",
  "power_mode_comment": "Jetson power mode Atlas is tuned and measured in (perf.ensure_power_mode); skipped on modules that have no mode of this name."
}
