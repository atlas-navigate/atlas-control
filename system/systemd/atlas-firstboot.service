# Managed by the Atlas updater. Gives a unit its own identity (TLS key,
# hotspot password, setup code) if the production line did not.
[Unit]
Description=Atlas device identity
ConditionPathExists=!/etc/atlas/identity/device.json
After=local-fs.target
Before=nginx.service atlas-control.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/atlas/bin/atlas-identity ensure
UMask=0022

[Install]
WantedBy=multi-user.target
