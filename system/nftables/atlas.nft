# Managed by the Atlas updater. Rendered to /run/atlas/firewall.nft by
# `atlas-engine firewall-up` (placeholders filled in) and loaded as its own
# table, leaving NetworkManager's and Docker's tables untouched.
table inet atlas_filter
delete table inet atlas_filter

table inet atlas_filter {
    chain input {
        type filter hook input priority filter + 10; policy drop;
        iif "lo" accept
        ct state established,related accept
        ct state invalid drop
        meta l4proto { icmp, ipv6-icmp } accept
        # Atlas web app and phone apps (nginx).
        tcp dport { 80, 443 } accept
        # Discovery: mDNS and the Atlas LAN beacon.
        udp dport { 5353, 5050 } accept
        # DHCP and DNS for phones on Atlas's own hotspot; DHCP client replies.
        udp dport { 53, 67, 68, 546 } accept
        tcp dport 53 accept
        # USB device-mode network (a cable plugged into Atlas = physical access).
        iifname "l4tbr0" accept
        @SSH_RULE@
    }
    chain output {
        type filter hook output priority filter + 10; policy accept;
        # The app's loopback port is for nginx and root only.
        oif "lo" tcp dport 5000 meta skuid != { 0, @WWW_UID@, @ATLAS_UID@ } reject with tcp reset
    }
}
