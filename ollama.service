# The base unit install.sh writes as /etc/systemd/system/ollama.service, with
# the account and the model directory filled in (stage 50). It names only
# what belongs to this unit's install; how Atlas runs Ollama — its tuning,
# llama-server's limits and the sandbox — is the release's drop-in
# (system/ollama/atlas.conf → ollama.service.d/atlas.conf), which every
# update keeps current.

[Unit]
Description=Ollama LLM Service (Atlas Control)
After=network.target
Wants=network.target

[Service]
Type=simple
User=OLLAMA_USER
Group=OLLAMA_GROUP
Environment="OLLAMA_MODELS=OLLAMA_DATA_DIR/models"
ExecStart=/usr/local/bin/ollama serve
Restart=always
RestartSec=5
TimeoutStartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ollama

[Install]
WantedBy=multi-user.target
